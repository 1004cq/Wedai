# Wedai Compose controls (used by deploy scripts, not application code)
COMPOSE_PROJECT_NAME=wedai-commercial
# Production and low-memory hosts should pull the CI-built image. Pin a full git SHA tag after validation.
WEDAI_DEPLOY_MODE=image
WEDAI_IMAGE=ghcr.io/1004cq/wedai:main
WEDAI_BUILD_CACHE_FROM=ghcr.io/1004cq/wedai:main
WEDAI_PROFILE=full
USE_CN_MIRROR=false

# Pinned infrastructure tags. Upgrade one at a time and verify health before committing changes.
WEDAI_POSTGRES_IMAGE=paradedb/paradedb:0.24.3-pg17
WEDAI_REDIS_IMAGE=redis:7.4.10-alpine3.21
WEDAI_RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.10
WEDAI_RUSTFS_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
WEDAI_SEARXNG_IMAGE=searxng/searxng:2026.7.28-c01178d03

# Public bindings. When using a reverse proxy, bind the app to 127.0.0.1.
WEDAI_BIND_ADDRESS=0.0.0.0
LOBE_PORT=3210
APP_URL=http://localhost:3210
INTERNAL_APP_URL=http://localhost:3210
AUTH_TRUSTED_ORIGINS=http://localhost:3210

# Required application secrets. Generate unique values; never commit the real file.
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
KEY_VAULTS_SECRET=CHANGE_ME_KEY_VAULTS_SECRET

# PostgreSQL
LOBE_DB_NAME=wedai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis is private to the Compose network; REDIS_URL is assembled by the Compose file.

# RustFS / S3.
# - Server upload uses S3_ENDPOINT (can be the internal Docker DNS, e.g. http://rustfs:9000).
# - Browser display uses public object URLs when S3_SET_ACL=1 + S3_PUBLIC_DOMAIN.
#   Nginx must proxy `/${RUSTFS_LOBE_BUCKET}/` to 127.0.0.1:9000 (path-style).
# - If S3_SET_ACL=0, S3_ENDPOINT itself must be browser-reachable (separate files subdomain).
RUSTFS_BIND_ADDRESS=127.0.0.1
RUSTFS_PORT=9000
RUSTFS_ADMIN_BIND_ADDRESS=127.0.0.1
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET_KEY
RUSTFS_LOBE_BUCKET=wedai
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_DOMAIN=https://cq.je
S3_SET_ACL=1

# full enables SearXNG; core overrides this to empty and skips the SearXNG image/container.
SEARXNG_URL=http://searxng:8080

# Optional authentication settings from the root .env.example.
# AUTH_ALLOWED_EMAILS=user1@example.com,user2@example.com
# AUTH_DISABLE_EMAIL_PASSWORD=1
# AUTH_EMAIL_VERIFICATION=1
# AUTH_ENABLE_MAGIC_LINK=1
# Required for async image generation (internal JWT) and OIDC.
# Generate: node scripts/generate-oidc-jwk.mjs  → set as JWKS_KEY='{"keys":[...]}'
# JWKS_KEY=

# Commercial: platform-managed model keys only (hide user Provider settings + reject BYOK writes).
BYOK_ALLOWED=false
FEATURE_FLAGS=-provider_settings,-openai_api_key,-openai_proxy_url
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# Optional proxy settings used by the application container.
# HTTP_PROXY=http://proxy.example.com:7890
# HTTPS_PROXY=http://proxy.example.com:7890

# Local source builds need substantial resources. Image mode skips this check.
WEDAI_LOCAL_BUILD_MIN_MEMORY_MB=7168
WEDAI_ALLOW_LOW_MEMORY_BUILD=0
# Pull infrastructure images while the app builds. Set 0 on slow disks or constrained networks.
WEDAI_PARALLEL_INFRA_PULL=1
