{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "target": "ESNext",
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/main/*"],
      "~common/*": ["./src/common/*"],
      // Exact package map so typechecking ../../src fixtures resolves the
      // desktop-installed MCP server; the catch-all `*` would otherwise map
      // `@modelcontextprotocol/server` to a non-existent relative path.
      "@modelcontextprotocol/server": ["./node_modules/@modelcontextprotocol/server"],
      "*": ["./*"]
    }
  },
  "include": [
    "../../src/libs/mcp/__tests__/fixtures/negotiationServers.ts",
    "src/main/**/*",
    "src/main/global.d.ts",
    "src/preload/**/*",
    "src/common/**/*",
    "electron-builder.js",
    "native-deps.config.js"
  ]
}
